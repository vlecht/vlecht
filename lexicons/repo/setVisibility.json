{
  "lexicon": 1,
  "id": "sh.tangled.repo.setVisibility",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Set a repo's visibility. Private repos are readable only by the owner and space members; everyone else receives RepoNotFound. Owner only.",
      "parameters": {
        "type": "params",
        "required": [],
        "properties": {}
      },
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repo", "visibility"],
          "properties": {
            "repo": { "type": "string", "description": "Repo DID or owner/name form." },
            "visibility": {
              "type": "string",
              "enum": ["public", "private"]
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["visibility"],
          "properties": {
            "visibility": { "type": "string", "enum": ["public", "private"] }
          }
        }
      },
      "errors": [
        { "name": "InvalidRequest" },
        { "name": "Unauthorized" },
        { "name": "RepoNotFound" }
      ]
    }
  }
}
